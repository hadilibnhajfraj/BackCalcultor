# ================== API CONFIG ==================
PORT=4000

# ================== DATABASE ===================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=123456
DB_NAME=cbitunisia

# ============== JWT KEYS & TOKENS ==============
JWT_PRIVATE_KEY_PATH=./keys/jwtRS256.key
JWT_PUBLIC_KEY_PATH=./keys/jwtRS256.key.pub
JWT_EXPIRES_IN=1h
REFRESH_EXPIRES_IN=7d

